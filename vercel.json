{
  "rewrites": [
    { "source": "/roteiro",           "destination": "/pages/roteiro.html" },
    { "source": "/minha-rota",        "destination": "/pages/minha-rota.html" },
    { "source": "/explorar",          "destination": "/pages/explorar.html" },
    { "source": "/eventos",           "destination": "/pages/eventos.html" },
    { "source": "/perfil",            "destination": "/pages/perfil.html" },
    { "source": "/admin",             "destination": "/pages/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
