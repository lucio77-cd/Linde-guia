{
  "rewrites": [
    {
      "source": "/roteiro",
      "destination": "/pages/roteiro.html"
    },
    {
      "source": "/minha-rota",
      "destination": "/pages/minha-rota.html"
    },
    {
      "source": "/explorar",
      "destination": "/pages/explorar.html"
    },
    {
      "source": "/eventos",
      "destination": "/pages/eventos.html"
    },
    {
      "source": "/perfil",
      "destination": "/pages/perfil.html"
    },
    {
      "source": "/admin",
      "destination": "/pages/admin.html"
    },
    {
      "source": "/privacidade",
      "destination": "/pages/privacidade.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), payment=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://unpkg.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.google-analytics.com https://nominatim.openstreetmap.org; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
