// firestore.rules
// Linde Guia — Treze Tílias (projeto Firebase "linde-guia")
//
// ⚠️ Estas regras são SÓ do Linde Guia. Cada app (Linde Guia, Los Pombitos,
// FayDai, etc.) tem o seu próprio projeto Firebase e as suas próprias
// regras — nunca cole as regras de um app no projeto de outro: tudo que
// não estiver listado aqui é NEGADO, então o app inteiro "some".
//
// MODELO
//   • Turista NÃO faz login. Os favoritos, selos e rotas salvas ficam no
//     aparelho (localStorage) e não passam pelo Firestore.
//   • Conteúdo turístico (pois, eventos, patrocinadores, configuracoes):
//     leitura pública; escrita só administrador.
//   • Analytics anônimo (acessos_diarios, rotas_criadas, checkins): o
//     turista só pode CRIAR registros no formato exato que o app grava;
//     só o administrador lê.
//   • Administrador = existe um documento em "usuarios_admin/{uid}" com o
//     UID da conta do Firebase Auth (e-mail/senha) usada no painel /admin.
//     Esse documento é criado manualmente no Console do Firebase.
//
// COLEÇÕES USADAS PELO CÓDIGO
//   pois, eventos, patrocinadores, configuracoes/geral, acessos_diarios,
//   rotas_criadas, checkins, usuarios_admin.
//   (usuarios e rotas_geradas ficam reservadas para um futuro login de
//   turista; nenhum código grava nelas hoje.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================
    function estaLogado() {
      return request.auth != null;
    }

    function ehDonoDoDocumento(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function ehAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios_admin/$(request.auth.uid));
    }

    // ============================================================
    // POIS — locais turísticos
    // Leitura pública. Escrita só admin.
    // O painel grava em snake_case (preco_estimado, status_operacional) e o
    // seed/legado pode usar camelCase — a validação aceita os dois.
    // ============================================================
    match /pois/{poiId} {
      allow get, list: if true;
      allow create, update: if ehAdmin() && poiTemCamposValidos();
      allow delete: if ehAdmin();

      function poiTemCamposValidos() {
        let d = request.resource.data;
        return d.nome is string && d.nome.size() > 0
          && d.categoria is string
          && (!('preco_estimado' in d) || (d.preco_estimado is number && d.preco_estimado >= 0))
          && (!('precoEstimado' in d)  || (d.precoEstimado is number && d.precoEstimado >= 0))
          && (!('status_operacional' in d) ||
              d.status_operacional in ['ativo', 'sazonal', 'em_reforma', 'fechado_temporariamente'])
          && (!('statusOperacional' in d) ||
              d.statusOperacional in ['ativo', 'sazonal', 'em_reforma', 'fechado_temporariamente']);
      }
    }

    // ============================================================
    // EVENTOS — leitura pública. Escrita só admin.
    // Datas podem vir como timestamp ou texto (eventos-data.js converte).
    // ============================================================
    match /eventos/{eventoId} {
      allow get, list: if true;
      allow create, update: if ehAdmin() && eventoTemCamposValidos();
      allow delete: if ehAdmin();

      function eventoTemCamposValidos() {
        let d = request.resource.data;
        return d.nome is string && d.nome.size() > 0
          && (!('data_inicio' in d) || d.data_inicio is timestamp || d.data_inicio is string)
          && (!('data_fim' in d)    || d.data_fim is timestamp    || d.data_fim is string)
          && (!('dataInicio' in d)  || d.dataInicio is timestamp  || d.dataInicio is string)
          && (!('dataFim' in d)     || d.dataFim is timestamp     || d.dataFim is string);
      }
    }

    // ============================================================
    // PATROCINADORES — banners de anúncio pago
    // Leitura pública (senão o banner não carrega pro turista).
    // Escrita só admin. O app grava "imagemBannerUrl" e "linkDestino"
    // (que é null quando o destino é um local ou o WhatsApp).
    // ============================================================
    match /patrocinadores/{patrocinadorId} {
      allow get, list: if true;
      allow create, update: if ehAdmin() && patrocinadorTemCamposValidos();
      allow delete: if ehAdmin();

      function patrocinadorTemCamposValidos() {
        let d = request.resource.data;
        return d.nome is string && d.nome.size() > 0
          && d.ativo is bool
          && (!('imagemBannerUrl' in d) || d.imagemBannerUrl is string)
          && (!('imagemUrl' in d) || d.imagemUrl is string)
          && (!('nivel' in d) || d.nivel == null || d.nivel in ['ouro', 'prata', 'bronze'])
          && (!('linkDestino' in d) || d.linkDestino == null
              || (d.linkDestino is string && d.linkDestino.matches('^https?://.*')));
      }
    }

    // ============================================================
    // CONFIGURACOES — documento único "configuracoes/geral"
    // (número de WhatsApp do botão flutuante e dos banners).
    // ============================================================
    match /configuracoes/{docId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['whatsappNumero'])
        && request.resource.data.whatsappNumero is string
        && request.resource.data.whatsappNumero.matches('^[0-9]{0,15}$');
      allow delete: if false;
    }

    // ============================================================
    // ACESSOS_DIARIOS — contador anônimo de visitas (registrar-acesso.js)
    // Doc ID = AAAA-MM-DD. O cliente só soma +1 por escrita.
    // ============================================================
    match /acessos_diarios/{dia} {
      allow get, list: if ehAdmin();
      allow create: if dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && acessoValido() && request.resource.data.total == 1;
      allow update: if acessoValido()
        && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;

      function acessoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['total', 'porHora'])
          && d.total is int
          && d.porHora is map;
      }
    }

    // ============================================================
    // ROTAS_CRIADAS — analytics (criação/finalização de roteiro)
    // Turista cria sem login; só admin lê. Histórico: nunca edita/apaga.
    // ============================================================
    match /rotas_criadas/{registroId} {
      allow create: if registroRotaTemCamposValidos();
      allow get, list: if ehAdmin();
      allow update, delete: if false;

      function registroRotaTemCamposValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'criadoEm', 'tipoEvento', 'horarioInicioEscolhido',
            'refeicoesDesejadas', 'interesses', 'quantidadeParadas',
            'paradasNomes', 'paradasIds', 'rotaId', 'capituloVazio',
            'quantidadeParadasTotal', 'quantidadeParadasVisitadas'
          ])
          && d.criadoEm == request.time
          && (!('tipoEvento' in d) || d.tipoEvento in ['criacao', 'capitulo', 'finalizacao'])
          && (!('rotaId' in d) || (d.rotaId is string && d.rotaId.size() <= 36))
          && (!('paradasIds' in d) || (d.paradasIds is list && d.paradasIds.size() <= 12))
          && (!('paradasNomes' in d) || (d.paradasNomes is list && d.paradasNomes.size() <= 12))
          && (!('interesses' in d) || (d.interesses is list && d.interesses.size() <= 20))
          && (!('refeicoesDesejadas' in d) || (d.refeicoesDesejadas is list && d.refeicoesDesejadas.size() <= 8));
      }
    }

    // ============================================================
    // CHECKINS — analytics (botão "Cheguei")
    // Mesmo padrão de rotas_criadas.
    // ============================================================
    match /checkins/{checkinId} {
      allow create: if checkinTemCamposValidos();
      allow get, list: if ehAdmin();
      allow update, delete: if false;

      function checkinTemCamposValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['rotaId', 'poiId', 'poiNome', 'poiCategoria', 'checkinEm', 'origemDeteccao'])
          && d.checkinEm == request.time
          && (!('rotaId' in d) || (d.rotaId is string && d.rotaId.size() <= 36))
          && (!('poiNome' in d) || (d.poiNome is string && d.poiNome.size() <= 200))
          && (!('poiId' in d) || d.poiId == null || (d.poiId is string && d.poiId.size() <= 100))
          && (!('poiCategoria' in d) || d.poiCategoria == null
              || (d.poiCategoria is string && d.poiCategoria.size() <= 50))
          && (!('origemDeteccao' in d) || d.origemDeteccao in ['gps', 'manual']);
      }
    }

    // ============================================================
    // EVENTOS_PATROCINIO — trilha anônima de exposição e interação
    // Append-only: turista pode criar eventos estritamente validados;
    // apenas admin pode consultar. Não armazenar dados pessoais ou GPS.
    // ============================================================
    match /eventos_patrocinio/{eventoId} {
      allow create: if eventoPatrocinioTemCamposValidos();
      allow get, list: if ehAdmin();
      allow update, delete: if false;

      function eventoPatrocinioTemCamposValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'tipoEvento', 'origem', 'criadoEm',
            'poiId', 'patrocinadorId', 'rotaId', 'nivel'
          ])
          && d.keys().hasAll(['tipoEvento', 'origem', 'criadoEm'])
          && d.criadoEm == request.time
          && d.tipoEvento in [
            'impressao', 'clique', 'whatsapp', 'instagram',
            'direcoes', 'checkin', 'parada_pulada'
          ]
          && d.origem in ['carrossel', 'banner', 'pagina-local', 'modo-rota']
          && (('poiId' in d && d.poiId is string && d.poiId.size() > 0 && d.poiId.size() <= 100)
            || ('patrocinadorId' in d && d.patrocinadorId is string
                && d.patrocinadorId.size() > 0 && d.patrocinadorId.size() <= 100))
          && (!('patrocinadorId' in d) ||
              (d.patrocinadorId is string && d.patrocinadorId.size() <= 100))
          && (!('poiId' in d) || (d.poiId is string && d.poiId.size() <= 100))
          && (!('rotaId' in d) || (d.rotaId is string && d.rotaId.size() <= 36))
          && (!('nivel' in d) || d.nivel in ['ouro', 'prata', 'bronze']);
      }
    }

    // ============================================================
    // USUARIOS_ADMIN — quem é administrador.
    // Só o próprio admin lê o seu documento (a API /api/gerar-relatorio usa
    // isso pra validar o login). Ninguém escreve pelo app: crie os
    // documentos manualmente no Console (ID do documento = UID do admin).
    // ============================================================
    match /usuarios_admin/{adminId} {
      allow get: if ehAdmin();
      allow list: if false;
      allow write: if false;
    }

    // ============================================================
    // RESERVADAS para um futuro login de turista (nada grava aqui hoje).
    // ============================================================
    match /usuarios/{userId} {
      allow read, write: if ehDonoDoDocumento(userId);
    }

    match /rotas_geradas/{rotaId} {
      allow create: if estaLogado() && request.resource.data.userId == request.auth.uid;
      allow get: if estaLogado() &&
        (resource.data.userId == request.auth.uid || ehAdmin());
      allow list: if ehAdmin();
      allow update, delete: if false;
    }

    // ============================================================
    // PADRÃO: tudo que não estiver acima é NEGADO.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
