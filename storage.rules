rules_version = '2';

// Linde Guia — banners públicos, upload restrito a administradores.
// A autorização consulta o mesmo documento usuarios_admin/{uid} usado
// pelas regras do Firestore. Exige habilitação da integração Storage ↔ Firestore
// no Firebase Console ao publicar estas regras.
service firebase.storage {
  match /b/{bucket}/o {
    match /banners-patrocinio/{arquivo} {
      allow read: if true;

      // Não permite exclusão nem metadados soltos: somente upload/substituição
      // de imagens aceitas, por UID cadastrado como administrador.
      allow write: if request.auth != null
                   && firestore.exists(
                     /databases/(default)/documents/usuarios_admin/$(request.auth.uid)
                   )
                   && request.resource != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
  }
}
